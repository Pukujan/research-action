{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-action.dev/schemas/assurance-envelope/1.0.0",
  "title": "AssuranceEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "layerId",
    "runId",
    "trace",
    "provBundleId",
    "subjectId",
    "inputRefs",
    "epistemicState",
    "failures",
    "provenance",
    "decisionContext",
    "policyVersion",
    "evaluatorVersion",
    "producedAt",
    "payload"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "layerId": { "type": "integer", "minimum": 1, "maximum": 9 },
    "runId": { "type": "string", "minLength": 1 },
    "trace": { "$ref": "#/$defs/traceContext" },
    "provBundleId": { "type": "string", "minLength": 1 },
    "subjectId": { "type": "string", "minLength": 1 },
    "inputRefs": {
      "type": "array",
      "items": { "$ref": "#/$defs/provEntityRef" }
    },
    "epistemicState": {
      "enum": [
        "UNASSESSED",
        "IN_PROGRESS",
        "SUPPORTED",
        "CONTESTED",
        "INSUFFICIENT_EVIDENCE",
        "HARD_FAILED",
        "HUMAN_REVIEW_REQUIRED",
        "HUMAN_VERIFIED",
        "SUPERSEDED"
      ]
    },
    "failures": {
      "type": "array",
      "items": { "$ref": "#/$defs/failure" }
    },
    "provenance": {
      "type": "array",
      "items": { "$ref": "#/$defs/provenanceLink" }
    },
    "decisionContext": { "$ref": "#/$defs/decisionContext" },
    "policyVersion": { "type": "string", "minLength": 1 },
    "evaluatorVersion": { "type": "string", "minLength": 1 },
    "producedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
    },
    "payload": true
  },
  "$defs": {
    "traceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traceId"],
      "properties": {
        "traceId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "spanId": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
      }
    },
    "decisionContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owningLayer", "scope", "policyId", "authority"],
      "properties": {
        "owningLayer": { "type": "integer", "minimum": 1, "maximum": 9 },
        "scope": { "type": "string", "minLength": 1 },
        "policyId": { "type": "string", "minLength": 1 },
        "authority": {
          "enum": ["AUTHORITATIVE", "SHADOW", "DIAGNOSTIC"]
        }
      }
    },
    "provEntityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "contentHash": { "type": "string", "minLength": 1 },
        "uri": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "class", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "class": {
          "enum": [
            "TRANSPORT_ERROR",
            "DEPENDENCY_UNAVAILABLE",
            "MALFORMED_INPUT",
            "MALFORMED_EVALUATOR_OUTPUT",
            "POLICY_REJECTED",
            "EPISTEMIC_ABSTENTION",
            "EVIDENCE_HARD_FAILURE"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "details": { "type": "object" }
      }
    },
    "provenanceLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation", "subjectId", "objectId"],
      "properties": {
        "relation": {
          "enum": [
            "used",
            "wasGeneratedBy",
            "wasDerivedFrom",
            "wasAttributedTo",
            "wasAssociatedWith",
            "hadPrimarySource",
            "wasQuotedFrom",
            "wasRevisionOf",
            "alternateOf",
            "specializationOf"
          ]
        },
        "subjectId": { "type": "string", "minLength": 1 },
        "objectId": { "type": "string", "minLength": 1 },
        "activityId": { "type": "string", "minLength": 1 }
      }
    }
  }
}
