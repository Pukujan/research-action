{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-action.dev/schemas/layer1/source-assessment/1.0.0",
  "title": "SourceAssessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claimRef",
    "sourceRef",
    "claimClass",
    "intendedUse",
    "sourceType",
    "evidenceRootId",
    "dimensions",
    "decision",
    "sufficientFor",
    "insufficientFor",
    "summary"
  ],
  "properties": {
    "claimRef": { "$ref": "#/$defs/entityRef" },
    "sourceRef": { "$ref": "#/$defs/entityRef" },
    "claimClass": {
      "enum": [
        "SOFTWARE_SPECIFICATION",
        "SOFTWARE_RUNTIME_BEHAVIOR",
        "SECURITY_CLAIM",
        "PRODUCT_TECHNOLOGY_COMPARISON",
        "OTHER"
      ]
    },
    "intendedUse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "riskTier"],
      "properties": {
        "category": { "type": "string", "minLength": 1 },
        "riskTier": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "description": { "type": "string" }
      }
    },
    "sourceType": { "type": "string", "minLength": 1 },
    "evidenceRootId": { "type": "string", "minLength": 1 },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityToClaim",
        "directness",
        "methodology",
        "reproducibility",
        "temporalFit",
        "versionFit",
        "independence",
        "transparency",
        "conflictOfInterest"
      ],
      "properties": {
        "authorityToClaim": { "$ref": "#/$defs/dimension" },
        "directness": { "$ref": "#/$defs/dimension" },
        "methodology": { "$ref": "#/$defs/dimension" },
        "reproducibility": { "$ref": "#/$defs/dimension" },
        "temporalFit": { "$ref": "#/$defs/dimension" },
        "versionFit": { "$ref": "#/$defs/dimension" },
        "independence": { "$ref": "#/$defs/dimension" },
        "transparency": { "$ref": "#/$defs/dimension" },
        "conflictOfInterest": { "$ref": "#/$defs/dimension" }
      }
    },
    "decision": { "enum": ["ACCEPT", "WARN", "ABSTAIN", "REJECT", "HUMAN_REVIEW"] },
    "sufficientFor": { "type": "array", "items": { "type": "string" } },
    "insufficientFor": { "type": "array", "items": { "type": "string" } },
    "summary": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "entityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "contentHash": { "type": "string", "minLength": 1 },
        "uri": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reasons", "evidenceRefs"],
      "properties": {
        "state": { "enum": ["STRONG", "ADEQUATE", "WEAK", "UNKNOWN", "NOT_APPLICABLE"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "evidenceRefs": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
