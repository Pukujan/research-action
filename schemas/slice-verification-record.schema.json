{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-action.dev/schemas/slice-verification-record/1.0.0",
  "title": "SliceVerificationRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sliceId",
    "sliceVersion",
    "gate",
    "mode",
    "verificationState",
    "requirementRefs",
    "commitRefs",
    "componentVersions",
    "checks",
    "smokeScenarios",
    "traceIds",
    "provRefs",
    "humanVerifications",
    "knownGaps",
    "proves",
    "doesNotProve",
    "producedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "sliceId": { "type": "string", "minLength": 1 },
    "sliceVersion": { "type": "string", "minLength": 1 },
    "gate": { "enum": ["A", "B0", "B1", "B2", "C", "D", "E", "F"] },
    "mode": { "enum": ["observe", "warn", "enforce"] },
    "verificationState": { "enum": ["NOT_RUN", "PARTIAL", "VERIFIED", "FAILED"] },
    "requiredValidationProfile": { "enum": ["A1", "A2", "A3", "A4", "A5"] },
    "achievedValidationProfile": { "enum": ["A1", "A2", "A3", "A4", "A5"] },
    "requirementRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "commitRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "componentVersions": {
      "type": "array",
      "items": { "$ref": "#/$defs/componentVersion" }
    },
    "environmentFingerprint": { "type": "string", "minLength": 1 },
    "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } },
    "smokeScenarios": { "type": "array", "items": { "$ref": "#/$defs/smokeScenario" } },
    "traceIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9a-f]{32}$" }
    },
    "provRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "humanVerifications": {
      "type": "array",
      "items": { "$ref": "#/$defs/humanVerification" }
    },
    "knownGaps": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "proves": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "doesNotProve": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "producedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" }
  },
  "$defs": {
    "status": { "enum": ["PASS", "FAIL", "NOT_RUN", "NOT_APPLICABLE"] },
    "componentVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "version"],
      "properties": {
        "component": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "status"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "evidenceRef": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "smokeScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "expected", "status"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "expected": { "type": "string", "minLength": 1 },
        "observed": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "traceId": { "type": "string", "pattern": "^[0-9a-f]{32}$" }
      }
    },
    "humanVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict"],
      "properties": {
        "reviewerId": { "type": "string", "minLength": 1 },
        "verdict": { "enum": ["EXPECTED", "INCORRECT", "UNCLEAR"] },
        "evidenceRef": { "type": "string", "minLength": 1 },
        "notes": { "type": "string", "minLength": 1 }
      }
    }
  }
}
